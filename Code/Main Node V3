String fmtFloat(float v, int dec) {
  if (isnan(v)) return "--";
  return String(v, dec);
}

// Returns marker color and label for one node index
void getSeverity(int idx, String &color, String &label, String &badgeClass, String &badgeLabel) {
  if (!dataReceived[idx]) {
    color = "#606880"; label = "Waiting";
    badgeClass = "aqi-good"; badgeLabel = "Waiting...";
    return;
  }
  SensorPacket &p = latest[idx];
  bool isRed =
    (!isnan(p.tempC)    && p.tempC    > 38)  ||
    (!isnan(p.humidity) && p.humidity > 85)  ||
    (p.uvIndex   > 8)                        ||
    (abs(p.vocDelta)    > 0.30)              ||
    (p.mq135PPM  > 2000);
  bool isYellow =
    (!isnan(p.tempC)    && p.tempC    > 30)  ||
    (!isnan(p.humidity) && p.humidity > 70)  ||
    (p.uvIndex   > 5)                        ||
    (abs(p.vocDelta)    > 0.15)              ||
    (p.mq135PPM  > 1000);
  if (isRed) {
    color = "#E24B4A"; label = "Alert";
    badgeClass = "aqi-high"; badgeLabel = "Alert";
  } else if (isYellow) {
    color = "#EF9F27"; label = "Moderate";
    badgeClass = "aqi-mod";  badgeLabel = "Moderate";
  } else {
    color = "#1D9E75"; label = "Good";
    badgeClass = "aqi-good"; badgeLabel = "Good";
  }
}

// Builds the cards HTML block for one node index — identical format to original
String buildNodeCards(int idx) {
  if (!dataReceived[idx]) {
    return "<div class='no-data'>⏳ No packets received yet — waiting for node " +
           String(idx + 1) + "...</div>";
  }
  SensorPacket &p = latest[idx];

  float tempBar = isnan(p.tempC)     ? 0 : constrain(p.tempC    / 50.0   * 100.0, 0, 100);
  float humiBar = isnan(p.humidity)  ? 0 : constrain(p.humidity,                   0, 100);
  float uvBar   =                          constrain(p.uvIndex   / 11.0   * 100.0, 0, 100);
  float vocBar  =                          constrain(abs(p.vocDelta) / 0.5 * 100.0, 0, 100);
  float co2Bar  =                          constrain(p.mq135PPM  / 5000.0 * 100.0, 0, 100);
  float hiBar   = isnan(p.heatIndex) ? 0 : constrain(p.heatIndex / 50.0   * 100.0, 0, 100);

  String badgeColor, markerLabel, badgeClass, badgeLabel;
  getSeverity(idx, badgeColor, markerLabel, badgeClass, badgeLabel);

  String s = "";
  s += "<div class='cards'>";

  // Temperature
  s += "<div class='card c-temp'>";
  s += "<div class='icon'>🌡️</div>";
  s += "<div class='label'>Temperature</div>";
  s += "<div><span class='value'>" + fmtFloat(p.tempC, 1) + "</span><span class='unit'>°C</span></div>";
  s += "<div class='sublabel'>" + getHeatIndexLevel(isnan(p.heatIndex) ? 0 : p.heatIndex) + "</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(tempBar, 1) + "%'></div></div>";
  s += "</div>";

  // Humidity
  s += "<div class='card c-humi'>";
  s += "<div class='icon'>💧</div>";
  s += "<div class='label'>Humidity</div>";
  s += "<div><span class='value'>" + fmtFloat(p.humidity, 1) + "</span><span class='unit'>%</span></div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(humiBar, 1) + "%'></div></div>";
  s += "</div>";

  // UV
  s += "<div class='card c-uv'>";
  s += "<div class='icon'>☀️</div>";
  s += "<div class='label'>UV Index</div>";
  s += "<div><span class='value'>" + fmtFloat(p.uvIndex, 1) + "</span><span class='unit'>UVI</span></div>";
  s += "<div class='sublabel'>" + getUVLevel(p.uvIndex) + "</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(uvBar, 1) + "%'></div></div>";
  s += "</div>";

  // VOC
  s += "<div class='card c-voc'>";
  s += "<div class='icon'>🌫️</div>";
  s += "<div class='label'>VOC Air</div>";
  s += "<div><span class='value'>" + fmtFloat(p.vocDelta, 3) + "</span><span class='unit'>V delta</span></div>";
  s += "<div class='sublabel'>" + getVOCLevel(p.vocDelta) + "</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(vocBar, 1) + "%'></div></div>";
  s += "</div>";

  // CO2
  s += "<div class='card c-co2'>";
  s += "<div class='icon'>💨</div>";
  s += "<div class='label'>CO2 MQ-135</div>";
  s += "<div><span class='value'>" + fmtFloat(p.mq135PPM, 0) + "</span><span class='unit'>ppm</span></div>";
  s += "<div class='sublabel'>" + getMQ135Level(p.mq135PPM) + "</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(co2Bar, 1) + "%'></div></div>";
  s += "</div>";

  // Heat Index
  s += "<div class='card c-hi'>";
  s += "<div class='icon'>🌡️</div>";
  s += "<div class='label'>Heat Index</div>";
  s += "<div><span class='value'>" + fmtFloat(p.heatIndex, 1) + "</span><span class='unit'>°C</span></div>";
  s += "<div class='sublabel'>Feels like</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(hiBar, 1) + "%'></div></div>";
  s += "</div>";

  s += "</div>"; // end .cards

  // Status row
  s += "<div class='status-row'>";
  s += "<p>Location</p>";
  s += "<strong>" + String(nodeNames[idx]) + "</strong>";
  s += "<div class='aqi-badge " + badgeClass + "'>" + badgeLabel + "</div>";
  s += "</div>";

  return s;
}

// ══════════════════════════════════════════════
//  BUILD PAGE
// ══════════════════════════════════════════════
String buildPage() {
  String html = String(htmlPage);

  // ── Build all 4 node sections ────────────────
  String sections = "";
  for (int i = 0; i < 4; i++) {
    String color, label, badgeClass, badgeLabel;
    getSeverity(i, color, label, badgeClass, badgeLabel);

    // First node open by default, rest collapsed
    String headerClass = (i == 0) ? "node-header open" : "node-header";
    String bodyClass   = (i == 0) ? "node-body open"   : "node-body";

    sections += "<div class='node-section'>";
    sections += "<div class='" + headerClass + "'>";
    sections += "<h2>&#9679; Node " + String(i + 1) + " — " + String(nodeNames[i]) + "</h2>";
    sections += "<span class='chevron'>▼</span>";
    sections += "</div>";
    sections += "<div class='" + bodyClass + "'>";
    sections += buildNodeCards(i);
    sections += "</div>";
    sections += "</div>";
  }
  html.replace("%NODE_SECTIONS%", sections);

  // ── Build nodes JSON for map markers ─────────
  String json = "[";
  for (int i = 0; i < 4; i++) {
    String color, label, badgeClass, badgeLabel;
    getSeverity(i, color, label, badgeClass, badgeLabel);

    String temp = fmtFloat(latest[i].tempC,    1);
    String humi = fmtFloat(latest[i].humidity, 1);
    String uv   = fmtFloat(latest[i].uvIndex,  1);
    String co2  = fmtFloat(latest[i].mq135PPM, 0);

    json += "{";
    json += "\"id\":"      + String(i + 1)          + ",";
    json += "\"name\":\""  + String(nodeNames[i])    + "\",";
    json += "\"lat\":"     + String(nodeLat[i], 4)   + ",";
    json += "\"lon\":"     + String(nodeLon[i], 4)   + ",";
    json += "\"color\":\"" + color                   + "\",";
    json += "\"label\":\"" + label                   + "\",";
    json += "\"hasData\":" + String(dataReceived[i] ? "true" : "false") + ",";
    json += "\"temp\":\""  + temp                    + "\",";
    json += "\"humi\":\""  + humi                    + "\",";
    json += "\"uv\":\""    + uv                      + "\",";
    json += "\"co2\":\""   + co2                     + "\"";
    json += "}";
    if (i < 3) json += ",";
  }
  json += "]";
  html.replace("%NODES_JSON%", json);

  return html;
}

// ══════════════════════════════════════════════
//  HTTP HANDLER
// ══════════════════════════════════════════════
void handleRoot() {
  server.send(200, "text/html", buildPage());
}

// ══════════════════════════════════════════════
//  SETUP
// ══════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  WiFi.mode(WIFI_AP_STA);

  Serial.println("\n##############################################");
  Serial.println("#   HUB NODE — ESP-NOW + WEB DASHBOARD      #");
  Serial.println("##############################################");
  Serial.print("  Hub MAC: ");
  Serial.println(WiFi.macAddress());
  Serial.println("  Copy the MAC above into HUB_MAC[] on every sensor node.");
  Serial.println("##############################################\n");

  if (esp_now_init() != ESP_OK) {
    Serial.println("[HUB] ESP-NOW init FAILED — halting.");
    while (true) delay(1000);
  }
  esp_now_register_recv_cb(onReceive);
  Serial.println("[HUB] ESP-NOW listening...");

  Serial.print("[HUB] Connecting to WiFi");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n[HUB] WiFi connected!");
  Serial.print("[HUB] Dashboard at: http://");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.begin();
  Serial.println("[HUB] Web server started.");
}

// ══════════════════════════════════════════════
//  LOOP
// ══════════════════════════════════════════════
void loop() {
  server.handleClient();
}
