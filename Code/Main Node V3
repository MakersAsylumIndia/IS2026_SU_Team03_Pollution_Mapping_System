// ══════════════════════════════════════════════
//  SHARED DATA PACKET  (must match sensor nodes)
// ══════════════════════════════════════════════
typedef struct SensorPacket {
  uint8_t  nodeId;
  float    tempC;
  float    humidity;
  float    heatIndex;
  float    vocVoltage;
  float    vocDelta;
  float    uvIndex;
  float    uvVoltage;
  float    uvRefVoltage;
  float    mq135PPM;
  float    mq135Voltage;
  int      vocRaw;
  int      uvRaw;
  int      mqRaw;
} SensorPacket;

// ── Latest packet per node (index 0–3 = nodeId 1–4) ──────────────────
SensorPacket latest[4];
bool dataReceived[4] = { false, false, false, false };

// ══════════════════════════════════════════════
//  LEVEL STRINGS
// ══════════════════════════════════════════════
String getHeatIndexLevel(float hi) {
  if      (hi < 27) return "Comfortable  ✔";
  else if (hi < 32) return "Warm         ⚠";
  else if (hi < 40) return "Hot          ✘";
  else              return "Danger       ✘✘";
}
String getVOCLevel(float delta) {
  float d = abs(delta);
  if      (d < 0.05) return "Clean Air    ✔✔";
  else if (d < 0.15) return "Good         ✔";
  else if (d < 0.30) return "Moderate     ⚠";
  else if (d < 0.50) return "Poor         ✘";
  else               return "Hazardous    ✘✘";
}
String getUVLevel(float uv) {
  if      (uv < 3)  return "Low          ✔✔ (0-2)";
  else if (uv < 6)  return "Moderate     ✔  (3-5)";
  else if (uv < 8)  return "High         ⚠  (6-7)";
  else if (uv < 11) return "Very High    ✘  (8-10)";
  else              return "Extreme      ☠  (11+)";
}
String getMQ135Level(float ppm) {
  if      (ppm < 450)  return "Excellent    ✔✔ (<450 ppm)";
  else if (ppm < 1000) return "Good         ✔  (450-1000 ppm)";
  else if (ppm < 2000) return "Moderate     ⚠  (1000-2000 ppm)";
  else if (ppm < 5000) return "Poor         ✘  (2000-5000 ppm)";
  else                 return "Hazardous    ✘✘ (>5000 ppm)";
}

// ══════════════════════════════════════════════
//  ESP-NOW RECEIVE CALLBACK
// ══════════════════════════════════════════════
void onReceive(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len != sizeof(SensorPacket)) {
    Serial.printf("[HUB] Unexpected packet size %d (expected %d) — ignored.\n",
                  len, sizeof(SensorPacket));
    return;
  }

  SensorPacket p;
  memcpy(&p, data, sizeof(SensorPacket));

  // nodeId is 1-based; store at index nodeId-1
  int idx = (int)p.nodeId - 1;
  if (idx < 0 || idx > 3) {
    Serial.printf("[HUB] nodeId %d out of range — ignored.\n", p.nodeId);
    return;
  }
  memcpy(&latest[idx], &p, sizeof(SensorPacket));
  dataReceived[idx] = true;

  char macStr[18];
  snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",
           info->src_addr[0], info->src_addr[1], info->src_addr[2],
           info->src_addr[3], info->src_addr[4], info->src_addr[5]);

  Serial.println("\n##############################################");
  Serial.printf( "#   LIVE DATA — NODE %d   (MAC: %s)\n", p.nodeId, macStr);
  Serial.println("##############################################");

  Serial.println("+--------------------------------------------+");
  Serial.println("|      TEMPERATURE & HUMIDITY  (DHT22)       |");
  Serial.println("+--------------------------------------------+");
  if (isnan(p.tempC) || isnan(p.humidity)) {
    Serial.println("|  ✘ DHT22 read failed on remote node.       |");
  } else {
    float tempF = p.tempC * 9.0 / 5.0 + 32.0;
    Serial.printf("|  Temperature  : %.2f C  /  %.2f F\n",  p.tempC, tempF);
    Serial.printf("|  Humidity     : %.2f %%\n",              p.humidity);
    Serial.printf("|  Heat Index   : %.2f C\n",               p.heatIndex);
    Serial.print( "|  Feels Like   : ");
    Serial.println(getHeatIndexLevel(p.heatIndex));
  }
  Serial.println("+--------------------------------------------+");
  Serial.println("|       VOC AIR QUALITY  (Fermion MEMS)      |");
  Serial.println("+--------------------------------------------+");
  Serial.printf( "|  Raw ADC      : %d\n",           p.vocRaw);
  Serial.printf( "|  Voltage      : %.4f V\n",       p.vocVoltage);
  Serial.printf( "|  Delta        : %.4f V from baseline\n", p.vocDelta);
  Serial.print(  "|  Air Quality  : ");
  Serial.println(getVOCLevel(p.vocDelta));
  Serial.println("+--------------------------------------------+");
  Serial.println("|          UV INDEX  (ML8511)                |");
  Serial.println("+--------------------------------------------+");
  Serial.printf( "|  Raw ADC      : %d\n",           p.uvRaw);
  Serial.printf( "|  Out Voltage  : %.4f V\n",       p.uvVoltage);
  Serial.printf( "|  Ref Voltage  : %.4f V\n",       p.uvRefVoltage);
  Serial.printf( "|  UV Index     : %.2f UV\n",      p.uvIndex);
  Serial.print(  "|  Risk Level   : ");
  Serial.println(getUVLevel(p.uvIndex));
  Serial.println("+--------------------------------------------+");
  Serial.println("|       CO2 / AIR QUALITY  (MQ-135)          |");
  Serial.println("+--------------------------------------------+");
  Serial.printf( "|  Raw ADC      : %d\n",           p.mqRaw);
  Serial.printf( "|  Voltage      : %.4f V\n",       p.mq135Voltage);
  Serial.printf( "|  Est. CO2     : %.2f ppm\n",     p.mq135PPM);
  Serial.print(  "|  Air Quality  : ");
  Serial.println(getMQ135Level(p.mq135PPM));
  Serial.println("+--------------------------------------------+");
  Serial.println("|                 ADVICE                     |");
  Serial.println("+--------------------------------------------+");
  bool allGood = true;
  if (!isnan(p.humidity)) {
    if (p.humidity > 85) {
      Serial.println("|  ⚠ Very high humidity — risk of mold.     |");
      allGood = false;
    } else if (p.humidity > 75) {
      Serial.println("|  i  Humidity elevated — normal for Goa.   |");
    }
  }
  if (!isnan(p.tempC) && p.tempC > 35) {
    Serial.println("|  ⚠ High temp — drink water frequently!     |");
    allGood = false;
  }
  if (abs(p.vocDelta) >= 0.30) {
    Serial.println("|  ✘ Elevated VOC — open windows!            |");
    allGood = false;
  }
  if (p.uvIndex >= 11) {
    Serial.println("|  ☠ EXTREME UV — stay indoors!              |");
    allGood = false;
  } else if (p.uvIndex >= 8) {
    Serial.println("|  ⚠ High UV rays — apply sunscreen.        |");
    allGood = false;
  } else if (p.uvIndex >= 6) {
    Serial.println("|  i  Moderate UV — some protection needed.  |");
    allGood = false;
  }
  if (p.mq135PPM >= 2000) {
    Serial.println("|  ✘ Poor CO2 levels — ventilate now!        |");
    allGood = false;
  } else if (p.mq135PPM >= 1000) {
    Serial.println("|  ⚠ Moderate CO2 — open a window.          |");
    allGood = false;
  }
  if (allGood) Serial.println("|  ✔ All readings normal — conditions good!  |");
  Serial.println("+--------------------------------------------+");
}

