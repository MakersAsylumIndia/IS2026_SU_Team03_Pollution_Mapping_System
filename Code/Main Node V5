typedef struct SensorPacket {
  uint8_t  nodeId;
  float    tempC;
  float    humidity;
  float    heatIndex;
  float    vocVoltage;
  float    vocDelta;
  float    uvIndex;
  float    uvVoltage;
  float    uvRefVoltage;
  float    mq135PPM;
  float    mq135Voltage;
  int      vocRaw;
  int      uvRaw;
  int      mqRaw;
} SensorPacket;

SensorPacket latest[4];
bool dataReceived[4] = { false, false, false, false };

String getHeatIndexLevel(float hi) {
  if      (hi < 27) return "Comfortable  ✔";
  else if (hi < 32) return "Warm         ⚠";
  else if (hi < 40) return "Hot          ✘";
  else              return "Danger       ✘✘";
}
String getVOCLevel(float delta) {
  float d = abs(delta);
  if      (d < 0.05) return "Clean Air    ✔✔";
  else if (d < 0.15) return "Good         ✔";
  else if (d < 0.30) return "Moderate     ⚠";
  else if (d < 0.50) return "Poor         ✘";
  else               return "Hazardous    ✘✘";
}
String getUVLevel(float uv) {
  if      (uv < 3)  return "Low          ✔✔ (0-2)";
  else if (uv < 6)  return "Moderate     ✔  (3-5)";
  else if (uv < 8)  return "High         ⚠  (6-7)";
  else if (uv < 11) return "Very High    ✘  (8-10)";
  else              return "Extreme      ☠  (11+)";
}
String getMQ135Level(float ppm) {
  if      (ppm < 450)  return "Excellent    ✔✔ (<450 ppm)";
  else if (ppm < 1000) return "Good         ✔  (450-1000 ppm)";
  else if (ppm < 2000) return "Moderate     ⚠  (1000-2000 ppm)";
  else if (ppm < 5000) return "Poor         ✘  (2000-5000 ppm)";
  else                 return "Hazardous    ✘✘ (>5000 ppm)";
}

// ── NEW: cigarette equivalent ─────────────────────────────────────────
String getCigaretteEquivalent(float ppm) {
  if      (ppm < 450)  return "😊 Air is clean — like breathing fresh mountain air!";
  else if (ppm < 1000) return "🚬 Like smoking 1 cigarette every 5 hours.";
  else if (ppm < 2000) return "🚬🚬 Like smoking 1 cigarette every 2 hours.";
  else if (ppm < 5000) return "🚬🚬🚬 Like smoking 1 cigarette per hour!";
  else                 return "💀 Like smoking 3+ cigarettes per hour — ventilate now!";
}

void onReceive(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len != sizeof(SensorPacket)) {
    Serial.printf("[HUB] Bad packet size %d (expected %d)\n", len, sizeof(SensorPacket));
    return;
  }
  SensorPacket p;
  memcpy(&p, data, sizeof(SensorPacket));

  int idx = (int)p.nodeId - 1;
  if (idx < 0 || idx > 3) {
    Serial.printf("[HUB] nodeId %d out of range\n", p.nodeId);
    return;
  }
  memcpy(&latest[idx], &p, sizeof(SensorPacket));
  dataReceived[idx] = true;

  char macStr[18];
  snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",
    info->src_addr[0], info->src_addr[1], info->src_addr[2],
    info->src_addr[3], info->src_addr[4], info->src_addr[5]);

  Serial.printf("[HUB] ✅ Packet from Node %d  MAC:%s  temp=%.1f  humi=%.1f\n",
    p.nodeId, macStr, p.tempC, p.humidity);
}

