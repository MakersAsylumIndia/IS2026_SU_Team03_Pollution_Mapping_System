String fmtFloat(float v, int dec) {
  if (isnan(v)) return "--";
  return String(v, dec);
}

void getSeverity(int idx, String &color, String &label, String &badgeClass, String &badgeLabel) {
  if (!dataReceived[idx]) {
    color = "#606880"; label = "Waiting";
    badgeClass = "aqi-good"; badgeLabel = "Waiting...";
    return;
  }
  SensorPacket &p = latest[idx];
  bool isRed =
    (!isnan(p.tempC)    && p.tempC    > 38) ||
    (!isnan(p.humidity) && p.humidity > 85) ||
    (p.uvIndex > 8) ||
    (abs(p.vocDelta) > 0.30) ||
    (p.mq135PPM > 2000);
  bool isYellow =
    (!isnan(p.tempC)    && p.tempC    > 30) ||
    (!isnan(p.humidity) && p.humidity > 70) ||
    (p.uvIndex > 5) ||
    (abs(p.vocDelta) > 0.15) ||
    (p.mq135PPM > 1000);
  if (isRed)         { color = "#E24B4A"; label = "Alert";    badgeClass = "aqi-high"; badgeLabel = "Alert"; }
  else if (isYellow) { color = "#EF9F27"; label = "Moderate"; badgeClass = "aqi-mod";  badgeLabel = "Moderate"; }
  else               { color = "#1D9E75"; label = "Good";     badgeClass = "aqi-good"; badgeLabel = "Good"; }
}



String buildNodeCards(int idx) {
  if (!dataReceived[idx])
    return "<div class='no-data'>⏳ No packets yet — waiting for node " + String(idx+1) + "...</div>";

  SensorPacket &p = latest[idx];
  float tempBar = isnan(p.tempC)    ? 0 : constrain(p.tempC    / 50.0  * 100.0, 0, 100);
  float humiBar = isnan(p.humidity) ? 0 : constrain(p.humidity,                  0, 100);
  float uvBar   =                         constrain(p.uvIndex   / 11.0  * 100.0, 0, 100);
  float vocBar  =                         constrain(abs(p.vocDelta)/0.5  * 100.0, 0, 100);
  float co2Bar  =                         constrain(p.mq135PPM  / 5000.0* 100.0, 0, 100);
  float hiBar   = isnan(p.heatIndex)? 0 : constrain(p.heatIndex / 50.0  * 100.0, 0, 100);

  String badgeColor, markerLabel, badgeClass, badgeLabel;
  getSeverity(idx, badgeColor, markerLabel, badgeClass, badgeLabel);

  String s = "<div class='cards'>";

  s += "<div class='card c-temp'><div class='icon'>🌡️</div><div class='label'>Temperature</div>";
  s += "<div><span class='value'>" + fmtFloat(p.tempC,1) + "</span><span class='unit'>°C</span></div>";
  s += "<div class='sublabel'>" + getHeatIndexLevel(isnan(p.heatIndex)?0:p.heatIndex) + "</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(tempBar,1) + "%'></div></div></div>";

  s += "<div class='card c-humi'><div class='icon'>💧</div><div class='label'>Humidity</div>";
  s += "<div><span class='value'>" + fmtFloat(p.humidity,1) + "</span><span class='unit'>%</span></div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(humiBar,1) + "%'></div></div></div>";

  s += "<div class='card c-uv'><div class='icon'>☀️</div><div class='label'>UV Index</div>";
  s += "<div><span class='value'>" + fmtFloat(p.uvIndex,1) + "</span><span class='unit'>UVI</span></div>";
  s += "<div class='sublabel'>" + getUVLevel(p.uvIndex) + "</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(uvBar,1) + "%'></div></div></div>";

  s += "<div class='card c-voc'><div class='icon'>🌫️</div><div class='label'>VOC Air</div>";
  s += "<div><span class='value'>" + fmtFloat(p.vocDelta,3) + "</span><span class='unit'>V delta</span></div>";
  s += "<div class='sublabel'>" + getVOCLevel(p.vocDelta) + "</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(vocBar,1) + "%'></div></div></div>";

  s += "<div class='card c-co2'><div class='icon'>💨</div><div class='label'>CO2 MQ-135</div>";
  s += "<div><span class='value'>" + fmtFloat(p.mq135PPM,0) + "</span><span class='unit'>ppm</span></div>";
  s += "<div class='sublabel'>" + getMQ135Level(p.mq135PPM) + "</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(co2Bar,1) + "%'></div></div></div>";

  s += "<div class='card c-hi'><div class='icon'>🌡️</div><div class='label'>Heat Index</div>";
  s += "<div><span class='value'>" + fmtFloat(p.heatIndex,1) + "</span><span class='unit'>°C</span></div>";
  s += "<div class='sublabel'>Feels like</div>";
  s += "<div class='bar-track'><div class='bar-fill' style='width:" + String(hiBar,1) + "%'></div></div></div>";

  s += "</div>"; // end .cards

  // ── ADVICE BOX ───────────────────────────────────────────────────────
  s += "<div class='advice-box'>";
  s += "<div class='advice-title'>💡 Advice</div>";

  // Temperature
  if (!isnan(p.tempC)) {
    if (p.tempC > 38)
      s += "<div class='advice-line advice-bad'>🌡️ Extreme heat — stay indoors and hydrate urgently!</div>";
    else if (p.tempC > 35)
      s += "<div class='advice-line advice-warn'>🌡️ High temp — drink water frequently, avoid direct sun.</div>";
    else if (p.tempC > 30)
      s += "<div class='advice-line advice-warn'>🌡️ Warm — stay hydrated.</div>";
    else
      s += "<div class='advice-line advice-good'>🌡️ Temperature is comfortable.</div>";
  }

  // Humidity
  if (!isnan(p.humidity)) {
    if (p.humidity > 85)
      s += "<div class='advice-line advice-bad'>💧 Very high humidity — open windows, mold risk!</div>";
    else if (p.humidity > 70)
      s += "<div class='advice-line advice-warn'>💧 Elevated humidity — monitor for mold.</div>";
    else
      s += "<div class='advice-line advice-good'>💧 Humidity is comfortable.</div>";
  }

  // UV
  if (p.uvIndex >= 11)
    s += "<div class='advice-line advice-bad'>☀️ Extreme UV — stay indoors, full cover if outside!</div>";
  else if (p.uvIndex >= 8)
    s += "<div class='advice-line advice-bad'>☀️ Very high UV — apply SPF 50+, hat and sunglasses.</div>";
  else if (p.uvIndex >= 6)
    s += "<div class='advice-line advice-warn'>☀️ High UV — apply sunscreen SPF 30+ before going out.</div>";
  else if (p.uvIndex >= 3)
    s += "<div class='advice-line advice-warn'>☀️ Moderate UV — sunscreen recommended if outdoors long.</div>";
  else
    s += "<div class='advice-line advice-good'>☀️ Low UV — no protection needed.</div>";

  // VOC
  float vd = abs(p.vocDelta);
  if (vd >= 0.50)
    s += "<div class='advice-line advice-bad'>🌫️ Hazardous VOC — open all windows immediately!</div>";
  else if (vd >= 0.30)
    s += "<div class='advice-line advice-warn'>🌫️ Poor air quality — open windows, check for sources.</div>";
  else if (vd >= 0.15)
    s += "<div class='advice-line advice-warn'>🌫️ Moderate VOC — some ventilation recommended.</div>";
  else
    s += "<div class='advice-line advice-good'>🌫️ VOC levels are clean.</div>";

  // CO2
  if (p.mq135PPM >= 5000)
    s += "<div class='advice-line advice-bad'>💨 Dangerous CO2 — evacuate and ventilate now!</div>";
  else if (p.mq135PPM >= 2000)
    s += "<div class='advice-line advice-warn'>💨 Poor CO2 — open windows immediately.</div>";
  else if (p.mq135PPM >= 1000)
    s += "<div class='advice-line advice-warn'>💨 Moderate CO2 — open a window.</div>";
  else
    s += "<div class='advice-line advice-good'>💨 CO2 levels are good.</div>";

  s += "</div>"; // end advice-box

  // ── STATUS ROW ───────────────────────────────────────────────────────
  s += "<div class='status-row'><p>Location</p><strong>" + String(nodeNames[idx]) + "</strong>";
  s += "<div class='aqi-badge " + badgeClass + "'>" + badgeLabel + "</div></div>";

  return s;
}

String buildPage() {
  String html = String(htmlPage);
  String sections = "";
  for (int i = 0; i < 4; i++) {
    String color, label, badgeClass, badgeLabel;
    getSeverity(i, color, label, badgeClass, badgeLabel);
    String headerClass = (i == 0) ? "node-header open" : "node-header";
    String bodyClass   = (i == 0) ? "node-body open"   : "node-body";
    sections += "<div class='node-section'>";
    sections += "<div class='" + headerClass + "'>";
    sections += "<h2>&#9679; Node " + String(i+1) + " — " + String(nodeNames[i]) + "</h2>";
    sections += "<span class='chevron'>▼</span></div>";
    sections += "<div class='" + bodyClass + "'>" + buildNodeCards(i) + "</div></div>";
  }
  html.replace("%NODE_SECTIONS%", sections);

  String json = "[";
  for (int i = 0; i < 4; i++) {
    String color, label, badgeClass, badgeLabel;
    getSeverity(i, color, label, badgeClass, badgeLabel);
    String cig = getCigaretteEquivalent(latest[i].mq135PPM);
    json += "{";
    json += "\"id\":"      + String(i+1)                                + ",";
    json += "\"name\":\""  + String(nodeNames[i])                       + "\",";
    json += "\"lat\":"     + String(nodeLat[i], 4)                      + ",";
    json += "\"lon\":"     + String(nodeLon[i], 4)                      + ",";
    json += "\"color\":\"" + color                                       + "\",";
    json += "\"label\":\"" + label                                       + "\",";
    json += "\"hasData\":" + String(dataReceived[i] ? "true" : "false") + ",";
    json += "\"temp\":\""  + fmtFloat(latest[i].tempC,    1)            + "\",";
    json += "\"humi\":\""  + fmtFloat(latest[i].humidity, 1)            + "\",";
    json += "\"uv\":\""    + fmtFloat(latest[i].uvIndex,  1)            + "\",";
    json += "\"co2\":\""   + fmtFloat(latest[i].mq135PPM, 0)            + "\",";
    json += "\"cig\":\""   + cig                                         + "\"";
    json += "}";
    if (i < 3) json += ",";
  }
  json += "]";
  html.replace("%NODES_JSON%", json);
  return html;
}

void handleRoot() { server.send(200, "text/html", buildPage()); }

void setup() {
  Serial.begin(115200);
  delay(500);

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  delay(200);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);

  Serial.println("\n##############################################");
  Serial.println("#   HUB NODE — ESP-NOW + WEB DASHBOARD      #");
  Serial.println("##############################################");
  Serial.printf("  Hub MAC  : %s\n", WiFi.macAddress().c_str());
  Serial.printf("  Channel  : %d\n", WiFi.channel());
  Serial.println("  Paste the MAC above into HUB_MAC[] on every sensor node.");
  Serial.println("##############################################\n");

  if (esp_now_init() != ESP_OK) {
    Serial.println("[HUB] ESP-NOW init FAILED — halting.");
    while (true) delay(1000);
  }
  esp_now_register_recv_cb(onReceive);
  Serial.println("[HUB] ESP-NOW ready on channel 1");

  Serial.print("[HUB] Connecting to WiFi");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
  Serial.println("\n[HUB] WiFi connected!");
  Serial.printf("[HUB] Router channel: %d\n", WiFi.channel());

  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  Serial.printf("[HUB] Forced back to channel 1. Current: %d\n", WiFi.channel());
  Serial.printf("[HUB] Dashboard at: http://%s\n", WiFi.localIP().toString().c_str());

  server.on("/", handleRoot);
  server.begin();
  Serial.println("[HUB] Web server started.");
}

void loop() {
  server.handleClient();
}
