#include "webpage_html.h"

// ══════════════════════════════════════════════
//  SETUP
// ══════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  memset(nodeActive, false, sizeof(nodeActive));

  // ── WiFi ─────────────────────────────────
  WiFi.mode(WIFI_AP_STA);   // AP_STA lets ESP-NOW and WiFi STA coexist
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("[HUB] Connecting to WiFi");
  int tries = 0;
  while (WiFi.status() != WL_CONNECTED && tries < 30) {
    delay(500); Serial.print("."); tries++;
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n[HUB] WiFi connected!");
    Serial.print("[HUB] Dashboard URL: http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\n[HUB] WiFi FAILED — check SSID/password. Running without web server.");
  }

  // ── Print hub MAC (for sensor nodes) ────
  Serial.print("[HUB] This hub's MAC: ");
  Serial.println(WiFi.macAddress());

  // ── ESP-NOW ───────────────────────────────
  if (esp_now_init() != ESP_OK) {
    Serial.println("[HUB] ESP-NOW init FAILED.");
    while (true) delay(1000);
  }
  esp_now_register_recv_cb(onReceive);
  Serial.println("[HUB] ESP-NOW listening...");

  // ── Web server routes ─────────────────────
  server.on("/", HTTP_GET, [](AsyncWebServerRequest *req) {
    req->send_P(200, "text/html", INDEX_HTML);
  });

  server.on("/data", HTTP_GET, [](AsyncWebServerRequest *req) {
    req->send(200, "application/json", buildJSON());
  });

  // SSE endpoint — browser connects once, hub pushes updates
  events.onConnect([](AsyncEventSourceClient *client) {
    Serial.println("[HUB] Browser connected to dashboard.");
    // Send current state immediately on connect
    // (short delay so client finishes handshake first)
  });
  server.addHandler(&events);

  server.begin();
  Serial.println("[HUB] Web server started.");
}

// ══════════════════════════════════════════════
//  LOOP
// ══════════════════════════════════════════════
void loop() {
  // Update lastSeen ages on the page every 5 seconds
  static unsigned long lastPush = 0;
  if (millis() - lastPush > 5000) {
    lastPush = millis();
    bool anyActive = false;
    for (int i = 0; i < MAX_NODES; i++) if (nodeActive[i]) { anyActive = true; break; }
    if (anyActive) events.send(buildJSON().c_str(), "update", millis());
  }
}
