#include <Arduino.h>
#include <DHT.h>

// ══════════════════════════════════════════════
//  PIN DEFINITIONS
// ══════════════════════════════════════════════
#define DHTPIN        4     // DHT22 DAT
#define DHTTYPE       DHT22
#define VOC_PIN       34    // Fermion VOC AOUT  (ADC1)
#define UV_PIN        33    // ML8511 OUT        (ADC1)
#define UV_REF_PIN    26    // ML8511 3.3V / REF pin (ADC2/ADC1)
#define UV_EN_PIN     32    // ML8511 EN
#define MQ135_PIN     35    // MQ-135 AOUT       (ADC1)
#define LED_POWER     2     // Power indicator LED (solid ON)

DHT dht(DHTPIN, DHTTYPE);

// ══════════════════════════════════════════════
//  GLOBALS & CALIBRATION VARIABLES
// ══════════════════════════════════════════════
float vocBaselineV = 2.0;   // Dynamically assigned in setup()
float mq135_R0 = 10000.0;   // Default baseline resistance for MQ-135
const float RL = 10000.0;   // Load resistor on standard MQ-135 breakout boards (10k ohms)

// ══════════════════════════════════════════════
//  HELPERS
// ══════════════════════════════════════════════

int getAveragedRaw(int pin, int samples = 64) {
  long sum = 0;
  for (int i = 0; i < samples; i++) {
    sum += analogRead(pin);
    delay(2);
  }
  return sum / samples;
}

float getCalibratedVoltage(int pin) {
  int raw = getAveragedRaw(pin);
  // ESP32 ADC Polynomial correction curve
  float v = -0.000000000000016 * pow(raw, 4)
           + 0.000000000118171 * pow(raw, 3)
           - 0.000000301211691 * pow(raw, 2)
           + 0.001109019271794 * raw
           + 0.034143524634089;
  return v;
}

float mapFloat(float x, float in_min, float in_max,
                        float out_min, float out_max) {
  return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

// ══════════════════════════════════════════════
//  SENSOR LEVEL FUNCTIONS
// ══════════════════════════════════════════════

String getHeatIndexLevel(float hi) {
  if      (hi < 27) return "Comfortable  ✔";
  else if (hi < 32) return "Warm         ⚠";
  else if (hi < 40) return "Hot          ✘";
  else              return "Danger       ✘✘";
}

String getVOCLevel(float delta) {
  float absDelta = abs(delta); 
  if      (absDelta < 0.05) return "Clean Air    ✔✔";
  else if (absDelta < 0.15) return "Good         ✔";
  else if (absDelta < 0.30) return "Moderate     ⚠";
  else if (absDelta < 0.50) return "Poor         ✘";
  else                      return "Hazardous    ✘✘";
}

float getUVIndex(float outVoltage, float refVoltage) {
  float zeroUVVoltage = refVoltage * 0.303; 
  float maxUVVoltage = refVoltage * 0.667;
  
  if (outVoltage < zeroUVVoltage) outVoltage = zeroUVVoltage;
  if (outVoltage > maxUVVoltage) outVoltage = maxUVVoltage;
  
  return mapFloat(outVoltage, zeroUVVoltage, maxUVVoltage, 0.0, 11.0);
}

String getUVLevel(float uv) {
  if      (uv < 3)  return "Low          ✔✔ (0-2)";
  else if (uv < 6)  return "Moderate     ✔  (3-5)";
  else if (uv < 8)  return "High         ⚠  (6-7)";
  else if (uv < 11) return "Very High    ✘  (8-10)";
  else              return "Extreme      ☠  (11+)";
}

float getMQ135PPM(float voltage) {
  if (voltage <= 0.1 || voltage >= 3.3) return 395.0; 
  
  float Rs = ((3.3 * RL) / voltage) - RL;
  float ratio = Rs / mq135_R0;
  
  return 116.602 * pow(ratio, -2.769);
}

String getMQ135Level(float ppm) {
  if      (ppm < 450)  return "Excellent    ✔✔ (<450 ppm)";
  else if (ppm < 1000) return "Good         ✔  (450-1000 ppm)";
  else if (ppm < 2000) return "Moderate     ⚠  (1000-2000 ppm)";
  else if (ppm < 5000) return "Poor         ✘  (2000-5000 ppm)";
  else                 return "Hazardous    ✘✘ (>5000 ppm)";
}

// ══════════════════════════════════════════════
//  SETUP
// ══════════════════════════════════════════════

void setup() {
  Serial.begin(115200);
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);

  // Power LED initialization
  pinMode(LED_POWER, OUTPUT);
  digitalWrite(LED_POWER, HIGH);  

  // ML8511 UV sensor enable
  pinMode(UV_EN_PIN, OUTPUT);
  digitalWrite(UV_EN_PIN, HIGH);

  dht.begin();

  Serial.println("\n##############################################");
  Serial.println("#     FULL SENSOR DASHBOARD  |  ESP32       #");
  Serial.println("##############################################\n");
  Serial.println("  Warming up sensors... 5 minutes");

  // Non-blocking visual delay sequence using text intervals
  for (int i = 300; i > 0; i -= 10) {
    Serial.print("  ⏳ "); Serial.print(i); Serial.println("s remaining...");
    delay(10000); // 10-second updates between counts
  }

  // DYNAMIC BASELINE SAMPLING
  Serial.println("  Initialising dynamic baseline calibrations...");
  vocBaselineV = getCalibratedVoltage(VOC_PIN);
  
  // Calibrate MQ-135 R0 assuming ~395ppm ambient background clean air base
  float mqVoltageInit = getCalibratedVoltage(MQ135_PIN);
  float Rs_clean = ((3.3 * RL) / mqVoltageInit) - RL;
  mq135_R0 = Rs_clean / pow((395.0 / 116.602), (1.0 / -2.769));

  Serial.println("\n  ✔ Calibration complete! All sensors actively polling.");
  Serial.println("##############################################");
}

// ══════════════════════════════════════════════
//  LOOP
// ══════════════════════════════════════════════

void loop() {
  // ── DHT22 ──────────────────────────────────
  float humidity  = dht.readHumidity();
  float tempC     = dht.readTemperature();
  float tempF     = dht.readTemperature(true);
  float heatIndex = (!isnan(tempC) && !isnan(humidity))
                    ? dht.computeHeatIndex(tempC, humidity, false) : NAN;

  // ── VOC ────────────────────────────────────
  int   vocRaw     = getAveragedRaw(VOC_PIN);
  float vocVoltage = getCalibratedVoltage(VOC_PIN);
  float vocDelta   = vocVoltage - vocBaselineV;
  String vocLevel  = getVOCLevel(vocDelta);

  // ── UV ─────────────────────────────────────
  int   uvRaw       = getAveragedRaw(UV_PIN);
  float uvVoltage   = getCalibratedVoltage(UV_PIN);
  float uvRefVoltage = getCalibratedVoltage(UV_REF_PIN); 
  float uvIndex     = getUVIndex(uvVoltage, uvRefVoltage);
  String uvLevelStr = getUVLevel(uvIndex);

  // ── MQ-135 ─────────────────────────────────
  int   mqRaw       = getAveragedRaw(MQ135_PIN);
  float mqVoltage   = getCalibratedVoltage(MQ135_PIN);
  float mqPPM       = getMQ135PPM(mqVoltage);
  String mqLevelStr = getMQ135Level(mqPPM);

  // ════════════════════════════════════════════
  //  SERIAL DASHBOARD OUTPUT
  // ════════════════════════════════════════════
  Serial.println("\n##############################################");
  Serial.println("#          LIVE SENSOR DASHBOARD            #");
  Serial.println("##############################################");

  // ── DHT22 ──────────────────────────────────
  Serial.println("+--------------------------------------------+");
  Serial.println("|      TEMPERATURE & HUMIDITY  (DHT22)       |");
  Serial.println("+--------------------------------------------+");
  if (isnan(tempC) || isnan(humidity)) {
    Serial.println("|  ✘ DHT22 read failed! Check wiring.        |");
  } else {
    Serial.print("|  Temperature  : "); Serial.print(tempC, 2); Serial.print(" C  /  "); Serial.print(tempF, 2); Serial.println(" F");
    Serial.print("|  Humidity     : "); Serial.print(humidity, 2); Serial.println(" %");
    Serial.print("|  Heat Index   : "); Serial.print(heatIndex, 2); Serial.println(" C");
    Serial.print("|  Feels Like   : "); Serial.println(getHeatIndexLevel(heatIndex));
  }

  // ── VOC ────────────────────────────────────
  Serial.println("+--------------------------------------------+");
  Serial.println("|       VOC AIR QUALITY  (Fermion MEMS)      |");
  Serial.println("+--------------------------------------------+");
  Serial.print("|  Raw ADC      : "); Serial.println(vocRaw);
  Serial.print("|  Voltage      : "); Serial.print(vocVoltage, 4); Serial.println(" V");
  Serial.print("|  Delta        : "); Serial.print(vocDelta,   4); Serial.println(" V from baseline");
  Serial.print("|  Air Quality  : "); Serial.println(vocLevel);

  // ── UV ─────────────────────────────────────
  Serial.println("+--------------------------------------------+");
  Serial.println("|          UV INDEX  (ML8511)                |");
  Serial.println("+--------------------------------------------+");
  Serial.print("|  Raw ADC      : "); Serial.println(uvRaw);
  Serial.print("|  Out Voltage  : "); Serial.print(uvVoltage, 4); Serial.println(" V");
  Serial.print("|  Ref Voltage  : "); Serial.print(uvRefVoltage, 4); Serial.println(" V");
  Serial.print("|  UV Index     : "); Serial.print(uvIndex,   2); Serial.println(" UV");
  Serial.print("|  Risk Level   : "); Serial.println(uvLevelStr);

  // ── MQ-135 ─────────────────────────────────
  Serial.println("+--------------------------------------------+");
  Serial.println("|       CO2 / AIR QUALITY  (MQ-135)          |");
  Serial.println("+--------------------------------------------+");
  Serial.print("|  Raw ADC      : "); Serial.println(mqRaw);
  Serial.print("|  Voltage      : "); Serial.print(mqVoltage, 4); Serial.println(" V");
  Serial.print("|  Est. CO2     : "); Serial.print(mqPPM,     2); Serial.println(" ppm");
  Serial.print("|  Air Quality  : "); Serial.println(mqLevelStr);

  // ── Advice ─────────────────────────────────
  Serial.println("+--------------------------------------------+");
  Serial.println("|                 ADVICE                     |");
  Serial.println("+--------------------------------------------+");

  bool allGood = true;

  if (!isnan(humidity)) {
    if (humidity > 85) {
      Serial.println("|  ⚠ Very high humidity — risk of mold.     |");
      allGood = false;
    } else if (humidity > 75) {
      Serial.println("|  i  Humidity elevated — normal for Goa.   |");
    }
  }
  if (!isnan(tempC) && tempC > 35) {
    Serial.println("|  ⚠ High temp — drink water frequently!     |");
    allGood = false;
  }
  if (abs(vocDelta) >= 0.30) {
    Serial.println("|  ✘ Elevated VOC — open windows!            |");
    allGood = false;
  }
  if (uvIndex >= 11) {
    Serial.println("|  ☠ EXTREME UV — stay indoors!              |");
} else if (uvIndex >= 8) {
    Serial.println("|  ✘ Very High UV — SPF 50+, hat & cover.   |");
} else if (uvIndex >= 6) {
    Serial.println("|  ⚠ High UV — apply SPF 30+ sunscreen.    |");
} else if (uvIndex >= 3) {
    Serial.println("|  ✔ Moderate UV — sunscreen recommended.   |");
}
  if (mqPPM >= 2000) {
    Serial.println("|  ✘ Poor CO2 levels — ventilate now!        |");
    allGood = false;
  } else if (mqPPM >= 1000) {
    Serial.println("|  ⚠ Moderate CO2 — open a window.          |");
    allGood = false;
  }
  if (allGood) {
    Serial.println("|  ✔ All readings normal — conditions good!  |");
  }

  Serial.println("+--------------------------------------------+");
  
  // 5-second sample interval rate-limiting delay
  delay(5000); 
}
